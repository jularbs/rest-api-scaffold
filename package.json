{
    "name": "@apps/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:up": "docker compose up -d postgres",
        "db:down": "docker compose down",
        "db:logs": "docker compose logs -f postgres",
        "db:ps": "docker compose ps",
        "db:migration:new": "dotenv -e .env -- dbmate new",
        "db:migrate": "dotenv -e .env -- dbmate up",
        "db:rollback": "dotenv -e .env -- dbmate rollback",
        "db:status": "dotenv -e .env -- dbmate status"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "envalid": "^8.1.1",
        "express": "^4.21.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "kysely": "^0.29.0",
        "luxon": "^3.7.2",
        "pg": "^8.20.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.2",
        "@types/node": "^22.10.1",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^2.1.8",
        "dbmate": "^2.35.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.9.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.67.0",
        "vitest": "^2.1.8"
    }
}